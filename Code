# ---------------- ENGINE ----------------
def parse_requirements(text):
    s=text.lower()
    budget=None
    m=re.search(r'(?:₹|rs\.?|inr)?\s*([0-9]+(?:\.[0-9]+)?)\s*(k|l|lakh)?', s)
    if m:
        n=float(m.group(1)); unit=m.group(2)
        if unit=="k": n*=1000
        elif unit in ("l","lakh"): n*=100000
        if n >= 5000: budget=n
    category="Laptop"
    for x in ["phone","laptop","tablet","monitor","keyboard","mouse","cpu","gpu","ram","ssd"]:
        if x in s: category=x.title(); break
    tasks=[]
    if any(x in s for x in ["game","gaming","gta","fps","esports"]): tasks.append("gaming")
    if any(x in s for x in ["code","coding","programming","android studio","vs code","developer"]): tasks.append("coding")
    if any(x in s for x in ["ai","ml","machine learning","tensorflow","pytorch"]): tasks.append("ai_ml")
    if any(x in s for x in ["edit","premiere","video","photoshop","design"]): tasks.append("editing")
    ram=16 if any(x in s for x in ["16gb","16 gb","32gb","32 gb"]) else 0
    storage=512 if any(x in s for x in ["512","1tb","1 tb","storage"]) else 0
    priority="performance" if any(x in s for x in ["performance","powerful","fast"]) else "value"
    if "battery" in s: priority="battery"
    if "portable" in s or "lightweight" in s: priority="portability"
    return category,budget,tasks,ram,storage,priority

def recommend(category,budget,tasks,ram,storage,priority,limit=12):
    con=db(); rows=con.execute("SELECT * FROM products WHERE category=?",(category,)).fetchall(); con.close()
    out=[]
    for r in rows:
        # indexes based on SELECT *
        price,rating,quality,perf,value = r[3:8]
        score=0
        if budget:
            if price<=budget: budget_score=100
            else: budget_score=max(0,100-(price-budget)/budget*150)
        else: budget_score=80
        score += budget_score*0.25
        score += quality*10*0.15
        score += rating*20*0.10
        score += value*10*0.15
        score += perf*10*0.15
        if ram: score += min(100,(r[8]/ram)*100 if r[8] else 0)*0.05
        if storage: score += min(100,(r[9]/storage)*100 if r[9] else 0)*0.05
        task_scores=[r[16] if t=="gaming" else r[17] if t=="coding" else r[18] if t=="ai_ml" else r[19] for t in tasks]
        score += (sum(task_scores)/len(task_scores) if task_scores else 75)*0.10
        if priority=="battery": score += r[11]*10*0.10
        elif priority=="portability": score += (100-r[14]/3*100 if r[14] else 50)*0.10
        out.append((score,r))
    return sorted(out,key=lambda x:x[0],reverse=True)[:limit]

