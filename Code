    def why(self,r,bud,tasks,ram,storage):
        a=[]
        if bud and r[3]<=bud:a.append("within budget")
        if ram and r[8]>=ram:a.append("meets RAM target")
        if storage and r[9]>=storage:a.append("meets storage target")
        for t in tasks:
            if (t=="gaming" and r[16]>=85) or (t=="coding" and r[17]>=85) or (t=="ai_ml" and r[18]>=85) or (t=="editing" and r[19]>=85): a.append(t.replace("_"," ")+" fit")
        return ", ".join(a[:4]) or "strong overall specifications"

