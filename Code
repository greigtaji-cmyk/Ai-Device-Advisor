        out=tk.StringVar()
        ttk.Button(self.main,text="Calculate Build",style="Accent.TButton",command=lambda:self.calc_build(vars,data,out)).pack(pady=20)
        ttk.Label(self.main,textvariable=out,font=("Segoe UI",13)).pack(anchor="w")

    def calc_build(self,vars,data,out):
        total=0; names=[]
        for cat in data:
            chosen=vars[cat].get()
            if chosen:
                name=chosen.split(" — ")[0]
                r=next((x for x in data[cat] if x[1]==name),None)
                if r: total+=r[3]; names.append(name)
        status="🟢 Basic configuration valid"
        if any("RTX 5070" in x for x in names) and any("Ryzen 5" in x for x in names): status="🟡 Valid, but a stronger CPU may better balance this GPU."
        out.set(f"{status}\nTotal: ₹{total:,.0f}\nComponents: {', '.join(names)}")

    def analytics(self):
        self.clear(); self.header("Analytics","Catalogue overview.")
        con=db(); rows=con.execute("SELECT category,COUNT(*),AVG(price),AVG(rating),AVG(quality) FROM products GROUP BY category").fetchall(); con.close()
        tree=ttk.Treeview(self.main,columns=("cat","count","avgprice","rating","quality"),show="headings")
        for c,h in zip(tree["columns"],["Category","Products","Average Price","Avg Rating","Avg Quality"]): tree.heading(c,text=h)
        for r in rows: tree.insert("", "end",values=(r[0],r[1],f"₹{r[2]:,.0f}",f"{r[3]:.2f}",f"{r[4]:.2f}"))
        tree.pack(fill="both",expand=True)

    def export_current(self):
        if not self.current: return
        path=filedialog.asksaveasfilename(defaultextension=".csv",filetypes=[("CSV","*.csv")])
        if not path:return
        with open(path,"w",newline="",encoding="utf-8") as f:
            w=csv.writer(f); w.writerow(["Match","Product","Category","Price","Rating","Quality","Performance","Value","RAM","Storage"])
            for score,r in self.current: w.writerow([round(score),r[1],r[2],r[3],r[4],r[5],r[6],r[7],r[8],r[9]])
        messagebox.showinfo("Exported","Recommendation report saved.")

