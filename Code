    def load_products(self):
        for x in self.tree.get_children(): self.tree.delete(x)
        con=db(); q="SELECT * FROM products WHERE name LIKE ?"; args=[f"%{self.search.get()}%"]
        if self.cat.get()!="All": q+=" AND category=?"; args.append(self.cat.get())
        for r in con.execute(q,args): self.tree.insert("", "end", values=(r[1],r[2],f"₹{r[3]:,.0f}",r[4],r[5],r[6],r[7]),iid=str(r[0]))
        con.close()

    def add_tree_to_compare(self):
        rows=self.get_selected_rows()
        if not rows:
            messagebox.showwarning("Compare", "Select one or more products first.")
            return
        self.selected.update(r[0] for r in rows)
        messagebox.showinfo("Compare", f"Added {len(rows)} product(s) to comparison. Select at least 2.")

    def get_selected_rows(self):
        ids=self.tree.selection() if hasattr(self,"tree") else []
        if not ids: return []
        con=db(); out=[]
        for i in ids:
            r=con.execute("SELECT * FROM products WHERE id=?",(i,)).fetchone()
            if r: out.append(r)
        con.close(); return out

    def compare(self):
        self.clear(); self.header("Compare Products","Select products from the Product Explorer, or use Compare buttons in recommendations.")
        con=db(); rows=[]
        for pid in self.selected:
            r=con.execute("SELECT * FROM products WHERE id=?",(pid,)).fetchone()
            if r: rows.append(r)
        con.close()
        if len(rows)<2:
            ttk.Label(self.main,text="Select at least 2 products in Product Explorer, then open Compare.").pack(pady=30)
            ttk.Button(self.main,text="Open Product Explorer",command=self.products).pack()
            return
        cols=["Specification"]+[r[1] for r in rows]
        tree=ttk.Treeview(self.main,columns=cols,show="headings")
        for c in cols: tree.heading(c,text=c); tree.column(c,width=180)
        data=[("Price",lambda r:f"₹{r[3]:,.0f}"),("Rating",lambda r:r[4]),("Quality",lambda r:r[5]),("Performance",lambda r:r[6]),("Value",lambda r:r[7]),("RAM",lambda r:r[8]),("Storage",lambda r:r[9]),("CPU",lambda r:r[12]),("GPU",lambda r:r[11]),("Weight",lambda r:r[14]),("Gaming",lambda r:r[16]),("Coding",lambda r:r[17]),("AI/ML",lambda r:r[18]),("Editing",lambda r:r[19])]
        for name,fn in data: tree.insert("", "end",values=[name]+[fn(r) for r in rows])
        tree.pack(fill="both",expand=True)

    def toggle_select(self,r):
        self.selected.add(r[0]); messagebox.showinfo("Compare",f"{r[1]} selected. Open Compare from the sidebar.")

    def save(self,r):
        con=db(); con.execute("INSERT INTO wishlist(product_id,created) VALUES(?,?)",(r[0],datetime.now().isoformat(timespec="seconds"))); con.commit(); con.close()
        messagebox.showinfo("Saved",f"{r[1]} added to wishlist.")

